rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────
    // Each instructor's data lives at:  users/{userId}/attendance/main
    //
    // Rules:
    //   • Any authenticated user can read and write their OWN data only.
    //   • Unauthenticated access is completely denied.
    //   • No user can read or write another user's data.
    // ──────────────────────────────────────────────────────────────────

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Deny everything else by default (Firestore's default, made explicit)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
